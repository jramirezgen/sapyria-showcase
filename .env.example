# Browser-safe values from Supabase project settings > API.
# Do not place sb_secret_* keys in this file or in Vercel browser variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# El origen canónico al que Supabase debe devolver tras confirmar o autorizar.
# Si se omite, se usa https://www.sapyria.com. En desarrollo se ignora: manda el
# origen real de la pestaña, para que localhost siga funcionando.
NEXT_PUBLIC_SITE_URL=https://www.sapyria.com
